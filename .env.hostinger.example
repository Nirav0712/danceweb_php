# ==============================================================================
# DYNAMICE CHILDREN ACADEMY — HOSTINGER PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# INSTRUCTIONS FOR HOSTINGER SHARED HOSTING:
# 1. Open Hostinger hPanel -> File Manager.
# 2. Navigate to your application root (typically `public_html/`).
# 3. Create a new file named exactly `.env` (with a leading dot).
# 4. Copy the contents of this file into your live `.env`.
# 5. Replace YOUR_HOSTINGER_DATABASE_PASSWORD with the exact password created in:
#    hPanel -> Databases -> MySQL Databases.
# 6. Save the file.
# 7. Test https://endless-coral-rook-02.hostingersite.com/health to verify connection.
# ==============================================================================

# Application Settings
APP_NAME="Dynamice Children Academy"
APP_ENV="production"
APP_DEBUG=false
APP_URL="https://endless-coral-rook-02.hostingersite.com"

# ==============================================================================
# Hostinger MySQL Database Configuration
# ==============================================================================
# In Hostinger hPanel -> Databases -> MySQL Databases:
# - DB_HOST: Hostinger shared hosting always uses "localhost" (do NOT use 127.0.0.1)
# - DB_PORT: 3306
# - DB_NAME: Your full database name (with Hostinger account prefix, e.g. u521358425_danceacademy)
# - DB_USER: Your full MySQL user (with Hostinger account prefix, e.g. u521358425_danceuser)
# - DB_PASS: Your database password (enter privately in Hostinger File Manager)
# ==============================================================================
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="u521358425_danceacademy"
DB_USER="u521358425_danceuser"
DB_PASS="YOUR_HOSTINGER_DATABASE_PASSWORD"
DB_CHARSET="utf8mb4"

# Session & Security Settings
SESSION_LIFETIME=7200
SESSION_SECURE=true
