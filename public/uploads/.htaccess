# ==============================================================================
# Security: Disable script execution in uploads directory
# Compatible with Hostinger LiteSpeed, Apache 2.4, FastCGI, and PHP-FPM
# ==============================================================================

# 1. Deny execution and direct web access to all script extensions
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|phar|cgi|pl|py|sh|bash|exe|bat|cmd|htaccess|htpasswd|ini|log|env|sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 2. Strip any script handler mappings
<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .phar .cgi .pl .py .sh
    RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .phar .cgi .pl .py .sh
</IfModule>

# 3. Disable CGI execution and directory listings
Options -ExecCGI -Indexes
