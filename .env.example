# ==============================================================================
# DYNAMICE CHILDREN ACADEMY — HOSTINGER PRODUCTION CONFIGURATION (.env)
# ==============================================================================
# INSTRUCTIONS FOR HOSTINGER SHARED HOSTING:
# 1. In Hostinger File Manager, create or edit the file named `.env` in `public_html/`.
# 2. In Hostinger hPanel, go to: Databases -> MySQL Databases.
# 3. Copy the exact details shown on that screen into the fields below.
# 4. Set APP_DEBUG=false for live production.
# ==============================================================================

APP_NAME="Dynamice Children Academy"
APP_ENV="production"
APP_DEBUG=false
APP_URL="https://dynamicechildrenacademy.com"

# ==============================================================================
# HOSTINGER MYSQL DATABASE CREDENTIALS
# ==============================================================================
# In Hostinger hPanel -> Databases -> MySQL Databases:
#
# DB_HOST: Hostinger almost always uses "localhost" (do NOT use 127.0.0.1 or remote IPs).
# DB_PORT: 3306
# DB_NAME: Full MySQL Database Name (e.g. u123456789_dynamice or u876543210_dance)
# DB_USER: Full MySQL User Name (e.g. u123456789_admin or u876543210_danceuser)
# DB_PASS: The password you set when creating the MySQL user in hPanel.
# ==============================================================================

DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="YOUR_HOSTINGER_DATABASE_NAME"
DB_USER="YOUR_HOSTINGER_DATABASE_USERNAME"
DB_PASS="YOUR_HOSTINGER_DATABASE_PASSWORD"
DB_CHARSET="utf8mb4"

# Alternative alias support (both naming conventions are supported by the app):
# DB_DATABASE="YOUR_HOSTINGER_DATABASE_NAME"
# DB_USERNAME="YOUR_HOSTINGER_DATABASE_USERNAME"
# DB_PASSWORD="YOUR_HOSTINGER_DATABASE_PASSWORD"

# Session & Security Settings
SESSION_LIFETIME=7200
SESSION_SECURE=true
