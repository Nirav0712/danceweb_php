# ==============================================================================
# DYNAMICE CHILDREN ACADEMY — PRODUCTION ENVIRONMENT TEMPLATE (.env)
# ==============================================================================
# INSTRUCTIONS FOR HOSTINGER DEPLOYMENT:
# 1. Copy this file as .env in your root directory (outside public_html if using Split setup).
# 2. Never place this file in public_html or expose it over HTTP.
# 3. Enter your actual Hostinger MySQL database credentials below.
# 4. Set APP_DEBUG to false in production.
# ==============================================================================

APP_NAME="Dynamice Children Academy"
APP_ENV="production"
APP_DEBUG=false
APP_URL="https://dynamicechildrenacademy.com"

# Hostinger MySQL Database Settings (hPanel -> Databases -> MySQL Databases)
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="u123456789_dynamice"
DB_USER="u123456789_admin"
DB_PASS="YourStrongDatabasePasswordHere"
DB_CHARSET="utf8mb4"

# Session & Security Settings
SESSION_LIFETIME=7200
SESSION_SECURE=true
